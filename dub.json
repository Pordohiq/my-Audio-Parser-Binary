{
	"authors": [
		"Pordohiq"
	],
	"copyright": "Copyright © 2026, Pordohiq",
	"description": "A Parser for different Audio files written in betterC (dlang).",
	"license": "MIT",
	"name": "my_audio_parser",
	"targetName": "mapb.dc",
	"mainSourceFile": "app.d",
	"targetType": "executable",
	"dflags": [
		"-betterC"
	],
	"configurations": [
		{
			"name": "default"
		},
		{
			"name": "static",
			"dflags": [
				"-static"
			]
		}
	],
	"buildTypes": {
		"release": {
			"dflags": [
				"-Os",
				"-flto=full",
				"-boundscheck=off"
			]
		},
		"debug": {
			"dflags": [
				"-O0",
				"-gc"
			]
		}
	},
	"sourcePaths": [
		"."
	],
	"importPaths": [
		"."
	]
}