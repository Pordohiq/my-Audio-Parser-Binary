{
	"authors": [
		"Pordohiq"
	],
	"copyright": "Copyright © 2026, Pordohiq",
	"description": "A Parser for different Audio files written in betterC (dlang).",
	"license": "MIT",
	"name": "my_audio_parser",
	"targetName": "mapb.dc",
	"targetType": "executable",
	"dflags": [
		"-betterC"
	],
	"buildTypes": {
		"release": {
			"dflags": [
				"-Os",
				"-flto=full",
				"-boundscheck=off"
			]
		},
		"debug": {
			"dflags": [
				"-O0",
				"-gc",
				"-d-debug"
			]
		}
	},
	"sourcePaths": [
		"."
	],
	"importPaths": [
		"."
	],
	"configurations": [
		{
			"name": "default",
			"platforms": [
				"posix"
			]
		},
		{
			"name": "windows-app",
			"platforms": [
				"posix"
			],
			"lflags": [
				"-fuse-ld=lld"
			]
		}
	]
}